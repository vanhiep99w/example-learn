{
  "name": "example-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "examples/*/*/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test",
    "check": "npm test && npm run typecheck && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "wrangler": "4.113.0"
  }
}
